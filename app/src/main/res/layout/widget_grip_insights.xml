<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_insights_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_surface"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_insights_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GRIPPULSE · TODAY"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_insights_live_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Now: Resting · 0m total"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_insights_toggle_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_live"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="TRACKING"
            android:textColor="#00BFA5"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main 2-column Body: Hand Bars (Left) + Most Frequent Grip Card (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Left Column: Hand Time Breakdown -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.25"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- Left Hand -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Left Hand"
                    android:textColor="#00BFA5"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_left_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0m · 0%"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_left_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="6dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_left" />

            <!-- Right Hand -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Right Hand"
                    android:textColor="#FF5A36"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_right_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0m · 0%"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_right_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="6dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_right" />

            <!-- Both Hands -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Two Hands"
                    android:textColor="#60A5FA"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_both_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0m · 0%"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_both_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="3dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_both" />
        </LinearLayout>

        <!-- Right Column: Most Frequent Grip Spotlight -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.95"
            android:background="@drawable/widget_card_inner"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOP GRIP"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_top_grip_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Waiting for hold"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_top_grip_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="0m · 0% share"
                android:textColor="#FFB300"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_updated_at"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to inspect"
                android:textColor="#64748B"
                android:textSize="9sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
